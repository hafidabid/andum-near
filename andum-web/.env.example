# The Andum API the app talks to (backend/). Must allow this origin through WEB_ORIGIN.
VITE_API_BASE=http://localhost:8090
# NEAR RPC used to read balances and the signing nonce (testnet). Comma separated, first that answers wins.
VITE_NEAR_RPC=https://test.rpc.fastnear.com,https://rpc.testnet.near.org
# Contract accounts (deployments/near.testnet.json)
VITE_NEAR_ROOT=hafidbuild.testnet
VITE_NEAR_CORE=core.hafidbuild.testnet
# Where transaction links point
VITE_EXPLORER=https://testnet.nearblocks.io
