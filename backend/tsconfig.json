{
  "compilerOptions": {
    "target": "ES2022", "module": "commonjs", "moduleResolution": "node",
    "strict": true, "esModuleInterop": true, "skipLibCheck": true, "resolveJsonModule": true,
    "experimentalDecorators": true, "emitDecoratorMetadata": true, "strictPropertyInitialization": false,
    "declaration": false, "outDir": "dist", "rootDir": "src", "sourceMap": true
  },
  "include": ["src/**/*"]
}
