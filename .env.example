# Copy to .env. Placeholders only: never commit real secrets.
NODE_ENV=development
PORT=8080
PUBLIC_API_BASE=http://localhost:8080
PUBLIC_WEB_BASE=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://andum:andum@localhost:5432/andum
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=andum
SESSION_SECRET=change-me-please
# 32 random bytes, base64:  openssl rand -base64 32
INVITE_ENC_KEY=

NEAR_RPC_URLS=https://test.rpc.fastnear.com,https://rpc.testnet.near.org
NEAR_ROOT=andum-hack.testnet
NEAR_CORE=core.andum-hack.testnet
NEAR_BRIDGE=bridge.andum-hack.testnet
RELAYER_ACCOUNT=relayer.andum-hack.testnet
RELAYER_PRIVATE_KEY=ed25519:...            # secret, only the relayer's gas key
RELAYER_DAILY_BUDGET_NEAR=5
TOPUP_NEAR=0.02
TOPUP_MIN_NEAR=0.005
BOOTSTRAP_PER_DAY=2
BRIDGE_WORKER_ACCOUNT=bridgeworker.andum-hack.testnet
BRIDGE_WORKER_PRIVATE_KEY=ed25519:...

# Sign-in methods. Email login is the product default (non-custodial: the browser holds the NEAR key).
AUTH_EMAIL_ENABLED=true
AUTH_LOCAL_ENABLED=true                     # key-only sign-in for dev/tests. Set false in production.
PRIVY_APP_ID=                               # optional; both must be set to enable the privy provider
PRIVY_VERIFICATION_KEY=                     # Privy dashboard verification key (PEM, ES256). [VERIFY] NEAR signing support first

# SMTP. Either one URL (Mailpit locally) or discrete settings (production providers need auth + TLS).
EMAIL_PROVIDER=smtp                         # smtp | console
EMAIL_FROM=Andum <no-reply@yourdomain.com>  # must be an address your provider has verified (SPF/DKIM)
SMTP_URL=smtp://localhost:1025
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587                             # 587 STARTTLS, 465 with SMTP_SECURE=true
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

BRIDGE_ENABLED=false
EVM_RELAYER_PK=0x...
EVM_SEPOLIA_RPC=
EVM_BASE_SEPOLIA_RPC=
EVM_SEPOLIA_CHAIN_ID=                       # optional: point the slot at a local anvil (31337) for rehearsals
EVM_BASE_SEPOLIA_CHAIN_ID=
EVM_GATEWAY_SEPOLIA=
EVM_GATEWAY_BASE_SEPOLIA=
EVM_DEPLOYER_PK=0x...
USE_FAKE_CHAIN=false                        # true: in-memory chain for UI demos without testnet
